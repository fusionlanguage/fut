public class Test
{
	public static bool Run()
	{
		string() s = "foobar"; //FAIL: cl
		string p = "foobar";
		return (s.LastIndexOf("") == 6 || s.LastIndexOf("") == -1 /* D */ || s.LastIndexOf("") == 0 /* Swift */)
			&& s.LastIndexOf("r") == 5
			&& s.LastIndexOf("bar") == 3
			&& s.LastIndexOf("foobar") == 0
			&& s.LastIndexOf("f") == 0
			&& s.LastIndexOf("oo") == 1
			&& s.LastIndexOf("barek") == -1
			&& (p.LastIndexOf("") == 6 || p.LastIndexOf("") == -1 /* D */ || p.LastIndexOf("") == 0 /* Swift */)
			&& p.LastIndexOf("r") == 5
			&& p.LastIndexOf("bar") == 3
			&& p.LastIndexOf("foobar") == 0
			&& p.LastIndexOf("f") == 0
			&& p.LastIndexOf("oo") == 1
			&& p.LastIndexOf("barek") == -1
			&& "afoobarfoobar".LastIndexOf(s) == 7
			&& "afoobarfoobar".LastIndexOf(p) == 7;
	}
}
