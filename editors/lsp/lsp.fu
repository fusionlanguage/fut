class FusionError
{
	internal int Line;
	internal int StartCharacter;
	internal int EndCharacter;
	internal string() Message;

	internal void Set!(int line, int startCharacter, int endCharacter, string message)
	{
		this.Line = line;
		this.StartCharacter = startCharacter;
		this.EndCharacter = endCharacter;
		this.Message = message;
	}
}

public abstract class FusionLanguageServer : FuSemaHost
{
	Dictionary<string(), string()>() OpenFiles;
	List<FusionError()>() Errors;

	public override void ReportError!(string filename, int line, int startUtf16Column, int endUtf16Column, string message)
	{
		this.Errors.Add();
		this.Errors.Last().Set(line, startUtf16Column, endUtf16Column, message);
	}

	protected abstract string() ReadStdin(int length);

	protected abstract void WatchClientProcess(int pid);

	protected abstract string GetFileScheme();

	static int GetHexDigit(int c)
	{
		if (c >= '0' && c <= '9')
			return c - '0';
		if (c >= 'A' && c <= 'F')
			return c - 'A' + 10;
		if (c >= 'a' && c <= 'f')
			return c - 'a' + 10;
		assert false;
	}

	string() UriToPath(string uri)
	{
		if (!uri.StartsWith("file:///"))
			return "";
		StringWriter() result;
		byte[256] decoded;
		int decodedCount = 0;
		nint pos = GetFileScheme().Length;
		for (;;) {
			nint percentPos = uri.IndexOf("%", pos);
			if (percentPos != pos || decodedCount == decoded.Length) {
				if (decodedCount > 0)
					result.Write(Encoding.UTF8.GetString(decoded, 0, decodedCount));
				if (percentPos < 0) {
					result.Write(uri.Substring(pos));
					return result.ToString();
				}
				result.Write(uri.Substring(pos, percentPos - pos));
				decodedCount = 0;
			}
			assert percentPos + 2 < uri.Length;
			decoded[decodedCount++] = GetHexDigit(uri[percentPos + 1]) << 4 | GetHexDigit(uri[percentPos + 2]);
			pos = percentPos + 3;
		}
	}

	static int GetInt(JsonElement json) => Math.Truncate(json.GetDouble());

	static void Send(string body)
	{
		string() content = $"{{ \"jsonrpc\": \"2.0\", {body} }}";
		Console.Write($"Content-Length: {Encoding.UTF8.GetByteCount(content)}\r\n\r\n{content}");
		Console.Out.Flush();
	}

	static string() EscapeString(string s) => s.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n");

	static void Respond(Dictionary<string(), JsonElement#> request, string resultOrError)
	{
		JsonElement idElement = request["id"];
		string() id = idElement.IsNumber() ? $"{GetInt(idElement)}" : $"\"{EscapeString(idElement.GetString())}\"";
		Send($"\"id\": {id}, {resultOrError}");
	}

	static void RespondNull(Dictionary<string(), JsonElement#> request)
	{
		Respond(request, "\"result\": null");
	}

	static void RespondError(Dictionary<string(), JsonElement#> request, int code, string message)
	{
		Respond(request, $"\"error\": {{ \"code\": {code}, \"message\": \"{message}\" }}");
	}

	void ParseOpenFile(string uri, FuParser! parser)
	{
		string text = OpenFiles[uri]; // TODO: check if exists
		parser.Parse(uri, Encoding.UTF8.GetBytes(text), Encoding.UTF8.GetByteCount(text));
	}

	static string() GetRange(int startLine, int startCharacter, int endLine, int endCharacter)
		=> $"{{ \"start\": {{ \"line\": {startLine}, \"character\" : {startCharacter} }}, \"end\": {{ \"line\": {endLine}, \"character\" : {endCharacter} }} }}";

	void SetOpenFile!(string uri, string text)
	{
		OpenFiles[uri] = text;

		FuProgram() program;
		this.Program = program;
		FuSystem# system = FuSystem.New();
		program.Parent = system;
		program.System = system;
		FuParser() parser;
		this.Errors.Clear();
		parser.SetHost(this);
		ParseOpenFile(uri, parser);
		StringWriter() w;
		w.Write($"\"method\": \"textDocument/publishDiagnostics\", \"params\": {{ \"uri\": \"{uri}\", \"diagnostics\": [");
		string prefix = "\n";
		foreach (FusionError error in this.Errors) {
			w.Write($"{prefix}{{ \"range\": {GetRange(error.Line, error.StartCharacter, error.Line, error.EndCharacter)}, \"severity\": 1, \"source\": \"fusion\", \"message\": \"{EscapeString(error.Message)}\" }}");
			prefix = ",\n";
		}
		w.Write("\n] }");
		Send(w.ToString());
	}

	void DoSema!()
	{
		if (this.Errors.Count > 0)
			return;
		FuSema() sema;
		sema.SetHost(this);
		sema.Process();
	}

	FuSymbol? FindSymbol!(Dictionary<string(), JsonElement#> textDocument, Dictionary<string(), JsonElement#> position)
	{
		string uri = textDocument["uri"].GetString();
		FuParser() parser;
		this.Errors.Clear();
		parser.SetHost(this);
		parser.FindName(uri, GetInt(position["line"]), GetInt(position["character"]));
		ParseOpenFile(uri, parser);
		DoSema();
		return parser.GetFoundDefinition();
	}

	FuSymbol? FindDefinition!(Dictionary<string(), JsonElement#> params)
	{
		Dictionary<string(), JsonElement#> textDocument = params["textDocument"].GetObject();
		Dictionary<string(), JsonElement#> position = params["position"].GetObject();
		FuSystem# system = FuSystem.New();
		this.Program.Parent = system;
		this.Program.System = system;
		return FindSymbol(textDocument, position);
	}

	string() GetLocation(string prefix, int loc)
	{
		int line = this.Program.GetLine(loc);
		FuSourceFile file = this.Program.GetSourceFile(line);
		int character = loc - this.Program.LineLocs[line];
		line -= file.Line;
		return $"{prefix}{{ \"uri\": \"{file.Filename}\", \"range\": {GetRange(line, character, line, character)} }}";
	}

	void RespondLocations(Dictionary<string(), JsonElement#> request, List<int> locs)
	{
		if (locs.Count == 0)
			RespondNull(request);
		else {
			StringWriter() w;
			string prefix = "\"result\": [\n";
			foreach (int loc in locs) {
				w.Write(GetLocation(prefix, loc));
				prefix = ",\n";
			}
			w.Write("\n]");
			Respond(request, w.ToString());
		}
	}

	string() GetContainerSymbol(string prefix, FuContainerType source, int kind)
	{
		int line = this.Program.GetLine(source.Loc);
		int character = source.Loc - this.Program.LineLocs[line];
		return $"{prefix}{{ \"name\": \"{source.Name}\", \"kind\": {kind}, \"range\": {GetRange(source.StartLine, source.StartColumn, source.EndLine, source.EndColumn)}, " +
			$"\"selectionRange\": {GetRange(line, character, line, character + source.GetLocLength())}, \"children\": [";
	}

	string() GetMemberSymbol(string prefix, FuSymbol symbol, int kind)
	{
		assert symbol is FuMember source;
		int line = this.Program.GetLine(source.Loc);
		int character = source.Loc - this.Program.LineLocs[line];
		return $"{prefix}{{ \"name\": \"{source.Name}\", \"kind\": {kind}, \"range\": {GetRange(source.StartLine, source.StartColumn, source.EndLine, source.EndColumn)}, " +
			$"\"selectionRange\": {GetRange(line, character, line, character + source.GetLocLength())} }}";
	}

	void HandleDocumentSymbol!(Dictionary<string(), JsonElement#> request, string uri)
	{
		FuProgram() program;
		this.Program = program;
		FuSystem# system = FuSystem.New();
		program.Parent = system;
		program.System = system;
		FuParser() parser;
		this.Errors.Clear();
		parser.SetHost(this);
		ParseOpenFile(uri, parser);
		StringWriter() w;
		w.Write("\"result\": [");
		string prefix = "\n";
		for (FuSymbol? container = program.First; container != null; container = container.Next) {
			switch (container) {
			case FuClass klass:
				w.Write(GetContainerSymbol(prefix, klass, 5));
				prefix = "\n";
				if (klass.Constructor != null) {
					w.Write(GetMemberSymbol(prefix, klass.Constructor, 9));
					prefix = ",\n";
				}
				for (FuSymbol? member = klass.First; member != null; member = member.Next) {
					int kind;
					switch (member) {
					case FuMethod:
						kind = 6;
						break;
					case FuField:
						kind = 8;
						break;
					case FuConst:
						kind = 14;
						break;
					default:
						assert false;
					}
					w.Write(GetMemberSymbol(prefix, member, kind));
					prefix = ",\n";
				}
				w.Write("\n] }");
				break;
			case FuEnum enu:
				w.Write(GetContainerSymbol(prefix, enu, 10));
				prefix = "\n";
				for (FuSymbol? value = enu.GetFirstValue(); value != null; value = value.Next) {
					w.Write(GetMemberSymbol(prefix, value, 22));
					prefix = ",\n";
				}
				w.Write("\n] }");
				break;
			default:
				assert false;
			}
			prefix = ",\n";
		}
		w.Write("\n]");
		Respond(request, w.ToString());
	}

	bool Handle!(Dictionary<string(), JsonElement#> request)
	{
		Dictionary<string(), JsonElement#> params = request["params"].GetObject();
		string method = request["method"].GetString();
		switch (method) {
		case "initialize":
			Respond(request, $"\"result\": {{ \"capabilities\": {{ \"textDocumentSync\": 1, \"hoverProvider\": true, \"definitionProvider\": true, \"implementationProvider\": true, \"referencesProvider\": true, \"documentSymbolProvider\": true }}, \"serverInfo\": {{ \"name\": \"Fusion\", \"version\": \"3.3.7\" }} }}"); // TODO: version
			JsonElement pid = params["processId"];
			if (pid.IsNumber())
				WatchClientProcess(GetInt(pid));
			break;
		case "shutdown":
			RespondNull(request);
			break;
		case "exit":
			return true;
		case "textDocument/didOpen":
			{
				Dictionary<string(), JsonElement#> textDocument = params["textDocument"].GetObject();
				SetOpenFile(textDocument["uri"].GetString(), textDocument["text"].GetString());
			}
			break;
		case "textDocument/didChange":
			{
				string uri = params["textDocument"].GetObject()["uri"].GetString();
				SetOpenFile(uri, params["contentChanges"].GetArray()[0].GetObject()["text"].GetString());
			}
			break;
		case "textDocument/didClose":
			{
				string uri = params["textDocument"].GetObject()["uri"].GetString();
				OpenFiles.Remove(uri);
				Send($"\"method\": \"textDocument/publishDiagnostics\", \"params\": {{ \"uri\": \"{uri}\", \"diagnostics\": [ ] }}");
			}
			break;
		case "textDocument/hover":
			{
				FuProgram() program;
				this.Program = program;
				FuSymbol? symbol = FindDefinition(params);
				if (symbol == null)
					RespondNull(request);
				else if (symbol.Documentation != null)
					Respond(request, $"\"result\": {{ \"contents\": [ {{ \"language\": \"fusion\", \"value\": \"{symbol.GetHover()}\" }}, \"{EscapeString(symbol.Documentation.ToString())}\" ] }}");
				else
					Respond(request, $"\"result\": {{ \"contents\": {{ \"language\": \"fusion\", \"value\": \"{symbol.GetHover()}\" }} }}");
			}
			break;
		case "textDocument/definition":
			{
				FuProgram() program;
				this.Program = program;
				FuSymbol? symbol = FindDefinition(params);
				if (symbol == null || symbol.Loc <= 0)
					RespondNull(request);
				else
					Respond(request, GetLocation("\"result\": ", symbol.Loc));
			}
			break;
		case "textDocument/implementation":
			{
				FuProgram() program;
				this.Program = program;
				FuSymbol? symbol = FindDefinition(params);
				RespondLocations(request, program.FindImplementations(symbol));
			}
			break;
		case "textDocument/references":
			{
				FuProgram() program;
				this.Program = program;
				FuSymbol? symbol = FindDefinition(params);
				FuSymbolReferenceVisitor() collector;
				RespondLocations(request, collector.FindReferences(program, symbol));
			}
			break;
		case "textDocument/documentSymbol":
			HandleDocumentSymbol(request, params["textDocument"].GetObject()["uri"].GetString());
			break;
		default:
			if (request.ContainsKey("id"))
				RespondError(request, -32601, "Method not found");
			break;
		}
		return false;
	}

	public int Serve!()
	{
		for (int contentLength = -1;;) {
			string() header = Console.ReadLine();
			if (header.Length == 0 || header[header.Length - 1] != '\r') {
				Console.Error.WriteLine("Missing CR in header");
				return 1;
			}
			if (header.StartsWith("Content-Length: ")) {
				if (!contentLength.TryParse(header.Substring("Content-Length: ".Length, header.Length - ("Content-Length: ".Length + 1)))) {
					Console.Error.WriteLine("Invalid Content-Length");
					return 1;
				}
			}
			else if (header.Length == 1) {
				if (contentLength < 0) {
					Console.Error.WriteLine("Missing Content-Length");
					return 1;
				}
				string() content = ReadStdin(contentLength);
				JsonElement# requestElement = JsonElement.Parse(content);
				if (Handle(requestElement.GetObject()))
					return 0;
				contentLength = -1;
			}
		}
	}
}
